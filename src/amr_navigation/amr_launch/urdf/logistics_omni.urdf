<?xml version="1.0" ?>
<robot name="logistics_omni" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ── 材质定义 ────────────────────────────────────────────── -->
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="dark">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <!-- ════════════════════════════════════════════════════════════
       base_footprint（投影原点，直接投影到地面）
       ════════════════════════════════════════════════════════════ -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- ════════════════════════════════════════════════════════════
       base_link（车体 0.6m × 0.4m × 0.2m）
       ════════════════════════════════════════════════════════════ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.4 0.2"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.4 0.2"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="30.0"/>
      <inertia ixx="0.8" ixy="0.0" ixz="0.0"
               iyy="1.2" iyz="0.0"
               izz="1.5"/>
    </inertial>
  </link>

  <!-- ════════════════════════════════════════════════════════════
       装饰性转向轮 ×4（四角，固定在 base_link 上，不参与运动学）
       ════════════════════════════════════════════════════════════ -->

  <!-- 左前轮 (FL) -->
  <joint name="wheel_fl_steer_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_fl_link"/>
    <origin xyz="0.20 0.15 -0.06" rpy="0 0 0"/>
  </joint>
  <link name="wheel_fl_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.06"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- 右前轮 (FR) -->
  <joint name="wheel_fr_steer_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_fr_link"/>
    <origin xyz="0.20 -0.15 -0.06" rpy="0 0 0"/>
  </joint>
  <link name="wheel_fr_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.06"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- 左后轮 (RL) -->
  <joint name="wheel_rl_steer_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_rl_link"/>
    <origin xyz="-0.20 0.15 -0.06" rpy="0 0 0"/>
  </joint>
  <link name="wheel_rl_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.06"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- 右后轮 (RR) -->
  <joint name="wheel_rr_steer_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_rr_link"/>
    <origin xyz="-0.20 -0.15 -0.06" rpy="0 0 0"/>
  </joint>
  <link name="wheel_rr_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.06"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ════════════════════════════════════════════════════════════
       激光雷达（顶部）
       ════════════════════════════════════════════════════════════ -->
  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>
  <link name="base_scan">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.05"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ════════════════════════════════════════════════════════════
       Gazebo 全向运动学插件（接收 /cmd_vel Twist）
       ════════════════════════════════════════════════════════════ -->
  <gazebo>
    <plugin name="gazebo_ros_planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=/cmd_vel_nav</remapping>
      </ros>
      <odometry_frame_id>gazebo_odom</odometry_frame_id>
      <robot_base_frame_id>base_link</robot_base_frame_id>
      <publish_odom_tf>0</publish_odom_tf>
      <publish_odom>0</publish_odom>
    </plugin>
  </gazebo>

  <!-- ── 激光雷达 Gazebo 传感器插件 ────────────────────────── -->
  <gazebo reference="base_scan">
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_laser_scan" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>out:=/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>base_scan</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ── 底盘颜色 ──────────────────────────────────────────── -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

</robot>
